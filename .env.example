# llm-price-monitor 环境变量模板
# 复制为 .env 后填写真实值；推荐用 dotenvx 加密管理：
#   npx @dotenvx/dotenvx set PRICE_MONITOR_AI_API_KEY <你的key>
#   npx @dotenvx/dotenvx set TAVILY_API_KEY <你的key>
# .env 不进仓库（.gitignore 已排除），私钥文件 .env.keys 只留在本机。
# 也可以直接把本文件复制为 .env 并填明文（明文 .env 不要提交）。

# AI 抽取用的模型 API Key（OpenAI 兼容接口）。
# 在 config/price-monitor.json 的 ai.api_key_env 里引用这个变量名；
# 当价格接口无法确定性解析时，AI 会用这个凭据分析响应证据。
PRICE_MONITOR_AI_API_KEY=sk-your-ai-api-key

# Tavily API Key（https://tavily.com），官方价刷新（管理面板 / POST /api/official/refresh）使用：
# 搜索各厂商官方定价页面，供 AI 提取官方模型原价。
TAVILY_API_KEY=tvly-your-tavily-key

# 可选：价格变化 webhook 通知地址（企业微信/钉钉/Slack 兼容的 {"text": ...} 端点）。
# 在 config/price-monitor.json 的 settings.webhook_env 里引用这个变量名。
# PRICE_MONITOR_WEBHOOK_URL=https://example.com/webhook/notify
