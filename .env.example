# llm-price-monitor 部署环境变量模板：复制为 .env 后按需填写，compose 自动读取同目录 .env
#   cp .env.example .env
# 真实 .env 已被 .gitignore 排除，令牌只放服务器，不要提交进仓库。

# 必填：读接口封锁令牌（api 与 web 共用同一个值），生成：openssl rand -hex 32
# 留空 = 不封锁，数据读接口对外可调（仅限本地试跑），生产必须填。
PRICE_WEB_INTERNAL_TOKEN=

# 镜像标签 = 线上版本号（git 短 SHA）：更新/回滚时按「日常运维」一节的命令追加或修改即可。
# 留空或注释 = 回退 local 标签（仅限本地试跑）。
# APP_TAG=

# 采集兜底代理（可选）：启用 mihomo 代理容器，吃机场订阅，配置步骤见 mihomo.example.yaml
# 与 docs/deploy/docker-compose.md「采集兜底代理」。取消下行注释即启用，停用删掉再 up -d。
# COMPOSE_PROFILES=default,proxy
